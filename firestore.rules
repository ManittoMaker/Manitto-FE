rules_version = '2';

// 현재 이 앱은 Firestore를 사용하지 않음 (API는 별도 서버, Firebase는 Hosting/Analytics만 사용)
// 의도적으로 모든 클라이언트 접근을 차단한다. Firestore를 도입하게 되면 그때 규칙을 다시 작성할 것.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
